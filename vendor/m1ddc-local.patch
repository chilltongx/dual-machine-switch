     DDCValue dummyAttr = {-1, -1};
 
-    prepareDDCRead(packet->data);
+    prepareDDCRead(packet);
 
     IOReturn err = performDDCWriteAtChipAddress(transport->service, transport->chipAddress, packet);
     if (err) {
@@ -122,6 +122,10 @@ static DDCValue readingOperation(DDCTransport *transport, DDCPacket *packet) {
         return dummyAttr;
     }
 
+    if (readPacket.data[4] != packet->data[2]) {
+        fprintf(stderr, "DDC reply did not echo the requested VCP code.\n");
